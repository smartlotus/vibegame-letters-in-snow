  "startScene": "scenes/main.scene.json",
  "manifests": ["assets/manifest.json"],
  "releaseExtraRoots": [".nojekyll"],
  "inputMap": "config/input-map.json",
  "runtimeDefaults": {
    "dev": { "appBasePath": "", "apiBaseUrl": "" },
    "deploy": { "appBasePath": "", "apiBaseUrl": "" }
  }
}
