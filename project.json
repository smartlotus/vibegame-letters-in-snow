{
  "name": "流年·雪中信",
  "version": "0.1.0",
  "engine": "vibegame@0.1.0",
  "settings": {
    "width": 1280,
    "height": 720,
    "scaleMode": "FIT",
    "pixelArt": false,
    "backgroundColor": "#03050a",
    "physics": {
      "gravity": { "x": 0, "y": 0 },
